PORT=5002
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/vit_shuttle
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Choose gmail for local development or a paid Render service.
# Render Free blocks SMTP, so use brevo there instead.
EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_SENDER_NAME=VIT Shuttle

# Required when EMAIL_PROVIDER=brevo. EMAIL_USER must be a verified Brevo sender.
BREVO_API_KEY=
