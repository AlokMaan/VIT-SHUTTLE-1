PORT=5002
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/vit_shuttle
JWT_SECRET=replace-with-a-long-random-value
JWT_EXPIRE=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# For local development or a paid Render service, Gmail SMTP uses the app password.
EMAIL_PROVIDER=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-character-google-app-password
EMAIL_SENDER_NAME=VIT Shuttle

# For Render Free, Gmail API sends directly through Gmail over HTTPS (no SMTP).
# Create these with a Google OAuth client that has the gmail.send scope.
# EMAIL_PROVIDER=gmail-api
# GMAIL_API_CLIENT_ID=
# GMAIL_API_CLIENT_SECRET=
# GMAIL_API_REFRESH_TOKEN=

# Required when EMAIL_PROVIDER=brevo. EMAIL_USER must be a verified Brevo sender.
BREVO_API_KEY=
