# ── Server ──────────────────────────────────────────
PORT=5002
NODE_ENV=development

# ── MongoDB ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/vit_shuttle?retryWrites=true&w=majority

# ── JWT ─────────────────────────────────────────────
JWT_SECRET=your-secure-random-jwt-secret-here
JWT_EXPIRE=7d

# ── Email Provider (auto | brevo | gmail | gmail-api) ─
EMAIL_PROVIDER=auto

# Gmail SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx

# Brevo (optional, preferred for production)
# BREVO_API_KEY=xkeysib-...

# Gmail API (optional)
# GMAIL_API_CLIENT_ID=
# GMAIL_API_CLIENT_SECRET=
# GMAIL_API_REFRESH_TOKEN=

# ── Razorpay ────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxx
RAZORPAY_KEY_SECRET=xxx

# ── Frontend ────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
